{
  "manifest_version": 3,
  "name": "Frontend Inspector",
  "version": "0.1.0",
  "description": "A Chrome DevTools extension for inspecting frontend applications.",
  "devtools_page": "devtools.html",
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": ["scripting"],
  "host_permissions": ["<all_urls>"],
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
